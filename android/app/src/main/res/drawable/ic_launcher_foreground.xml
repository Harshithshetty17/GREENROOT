<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground. 108dp canvas; the launcher may mask anything
     outside the central 66dp, so the seedling is kept inside that circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The launcher may mask to a 66dp circle: scale the mark in
         about the canvas centre so the right leaf tip is not clipped. -->
    <group android:scaleX="0.85" android:scaleY="0.85"
           android:pivotX="54" android:pivotY="54">
    <!-- Stem -->
        <path
            android:pathData="M54,84 V52"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round" />

        <!-- Upper right leaf -->
        <path
            android:pathData="M55,55 C55,40 66,30 82,29 C83,45 72,55 55,55 Z"
            android:fillColor="#FFFFFF" />

        <!-- Lower left leaf, smaller so the pair reads as a sprouting seedling -->
        <path
            android:pathData="M53,67 C53,55 44,47 30,46 C29,60 38,67 53,67 Z"
            android:fillColor="#D8F0E2" />
    </group>
</vector>
