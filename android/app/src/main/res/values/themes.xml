<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Applied at launch, then swapped for Theme.GreenRoot by
         installSplashScreen(). The API 31+ splash API needs the parent to be
         Theme.SplashScreen. -->
    <style name="Theme.GreenRoot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.GreenRoot</item>
    </style>

    <style name="Theme.GreenRoot" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">#1F7A4D</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>
</resources>
