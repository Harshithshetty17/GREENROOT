<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above. Same rule for cloud backup and for a direct
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="saved_cards.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="saved_cards.json" />
    </device-transfer>
</data-extraction-rules>
