# Copy to android/keystore.properties and fill in. That file is gitignored:
# a leaked upload key means nobody else can ever publish an update to your
# listing, and Google cannot reset it for you without a support request.
#
# Generate the keystore once, and back it up somewhere you will still have
# in three years:
#
#   keytool -genkey -v -keystore greenroot-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias greenroot
#
storeFile=greenroot-upload.jks
storePassword=CHANGE_ME
keyAlias=greenroot
keyPassword=CHANGE_ME
